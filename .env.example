# Hiçbiri yerel geliştirme için zorunlu değil: DATABASE_URL yoksa .data/pglite içinde
# gömülü bir Postgres açılır, şifre sıfırlama e-postaları sunucu konsoluna yazılır.

# Postgres bağlantısı (Neon, Frankfurt). Production'da zorunlu.
DATABASE_URL=

# Oturum çerezlerini imzalar. Production'da zorunlu; üretmek için: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Uygulamanın açık adresi (ör. https://asistan.app). Yerelde http://localhost:3000
BETTER_AUTH_URL=

# İsteğe bağlı: tanımlıysa giriş ve kayıt ekranında "Google ile devam et" görünür.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# İsteğe bağlı: tanımlıysa "Apple ile devam et" görünür (Apple Developer hesabı gerekir).
# APPLE_CLIENT_ID = Services ID (ör. app.alanadin.web). Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple
# Önerilen: Team ID, Key ID ve "Sign in with Apple" anahtarının (.p8) içeriği verilir; sunucu
# gizli anahtarı (JWT) kendisi üretir ve yeniler. Satır sonlarını \n olarak yazabilirsiniz.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Alternatif: elle üretilmiş JWT (6 ayda bir süresi dolar). Yukarıdaki üçlü varsa kullanılmaz.
APPLE_CLIENT_SECRET=
# Yalnızca ileride yerel iOS uygulaması olursa (Bundle ID).
APPLE_APP_BUNDLE_IDENTIFIER=

# İsteğe bağlı: şifre sıfırlama e-postaları için Resend. Production'da yoksa "Şifremi unuttum" gizlenir.
RESEND_API_KEY=
EMAIL_FROM="Asistan <bildirim@alanadin.com>"

# Asistan (Claude). Boşsa asistan çevrimdışı, kural tabanlı motorla çalışır.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_FAST_MODEL=claude-haiku-4-5

# Bildirimler. Web Push için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:destek@ornek.com
# Zamanlanmış iş (vercel.json → /api/cron/notifications) bu değerle çağrılır.
CRON_SECRET=

# Paylaşılan hız sınırı (isteğe bağlı; yoksa sunucu belleği kullanılır)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Önizleme / E2E: production derlemesini gömülü Postgres ve demo verisi düğmesiyle çalıştır.
# Gerçek yayında kapalı bırakın.
# LOCAL_DB=1
# DEMO_MODE=1
# Uçtan uca testlerde kayıt hız sınırını kapatır:
# AUTH_RATE_LIMIT=0
