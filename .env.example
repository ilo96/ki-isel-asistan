# Hiçbiri yerel geliştirme için zorunlu değil: DATABASE_URL yoksa .data/pglite içinde
# gömülü bir Postgres açılır, şifre sıfırlama e-postaları sunucu konsoluna yazılır.

# Postgres bağlantısı (Neon, Frankfurt). Production'da zorunlu.
DATABASE_URL=

# Oturum çerezlerini imzalar. Production'da zorunlu; üretmek için: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Uygulamanın açık adresi. Yayında https://app.vantrelcode.com (mobil uygulamanın açtığı sunucu).
# Yerelde http://localhost:3000
BETTER_AUTH_URL=

# Yayında 1: sayfalar yalnızca Android/iOS uygulamasının içinde açılır, tarayıcıdan gelenler
# tanıtım sayfasına (LANDING_URL) yönlenir. E-postadaki şifre sıfırlama bağlantısı hariç.
APP_ONLY=
# LANDING_URL=https://vantrelcode.com

# İsteğe bağlı: tanımlıysa giriş ve kayıt ekranında "Google ile devam et" görünür.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobil uygulama: iPhone'daki yerel Google girişi için "iOS" türündeki OAuth istemci kimliği.
# Android için ayrıca "Android" türünde bir istemci açılır (paket adı + SHA-1); kimliği buraya yazılmaz.
GOOGLE_IOS_CLIENT_ID=

# İsteğe bağlı: tanımlıysa "Apple ile devam et" görünür (Apple Developer hesabı gerekir).
# APPLE_CLIENT_ID = Services ID (ör. app.alanadin.web). Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple
# Önerilen: Team ID, Key ID ve "Sign in with Apple" anahtarının (.p8) içeriği verilir; sunucu
# gizli anahtarı (JWT) kendisi üretir ve yeniler. Satır sonlarını \n olarak yazabilirsiniz.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Alternatif: elle üretilmiş JWT (6 ayda bir süresi dolar). Yukarıdaki üçlü varsa kullanılmaz.
APPLE_CLIENT_SECRET=
# iOS uygulamasının Bundle ID'si (varsayılan com.vantrelcode.app); iPhone'daki yerel Apple girişi ve bildirimler kullanır.
# APPLE_APP_BUNDLE_IDENTIFIER=com.vantrelcode.app

# İsteğe bağlı: şifre sıfırlama e-postaları için Resend. Production'da yoksa "Şifremi unuttum" gizlenir.
RESEND_API_KEY=
EMAIL_FROM="Vantrel <bildirim@alanadin.com>"

# Asistan (Claude). Boşsa asistan çevrimdışı, kural tabanlı motorla çalışır.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_FAST_MODEL=claude-haiku-4-5

# Mobil uygulama bildirimleri.
# Android: Firebase Console › Proje ayarları › Hizmet hesapları › yeni özel anahtar (JSON, tek satır).
FCM_SERVICE_ACCOUNT=
# iOS: Apple Developer › Keys › Apple Push Notifications service anahtarı (.p8 içeriği ve Key ID).
# Team ID APPLE_TEAM_ID'den okunur. Xcode'dan doğrudan kurulan derlemeleri denerken APNS_ENV=sandbox.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# APNS_ENV=production

# Tarayıcı bildirimleri (mobil uygulamada kullanılmaz). Web Push için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:destek@ornek.com
# Zamanlanmış iş (vercel.json → /api/cron/notifications) bu değerle çağrılır.
CRON_SECRET=

# Paylaşılan hız sınırı (isteğe bağlı; yoksa sunucu belleği kullanılır)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Önizleme / E2E: production derlemesini gömülü Postgres ve demo verisi düğmesiyle çalıştır.
# Gerçek yayında kapalı bırakın.
# LOCAL_DB=1
# DEMO_MODE=1
# Uçtan uca testlerde kayıt hız sınırını kapatır:
# AUTH_RATE_LIMIT=0
